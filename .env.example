# Copy this file to .env.local and paste your keys in.
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real keys.
#
# The app runs WITHOUT any of these — every stage degrades to a hardcoded
# default rather than erroring. Keys make the output good, not possible.

# Intent routing (fast, free, no credit card) -> https://console.groq.com/keys
GROQ_API_KEY=

# Creative brief (free tier, no credit card) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Background video + photo search (free, no card) -> https://www.pexels.com/api/
PEXELS_API_KEY=

# Transparent sticker GIFs (free beta key, instant) -> https://developers.giphy.com/dashboard/
GIPHY_API_KEY=

# --- optional tuning, safe to leave unset ---

# Output height in px. 1920 = 1080x1920 (default). Drop to 1280 for 720x1280
# if the Render free instance (0.1 CPU) encodes too slowly. Width is derived 9:16.
VIDEO_HEIGHT=1920

# Seconds of finished video. Brief asks for 5-10.
VIDEO_DURATION=8

# x264 speed/quality tradeoff. veryfast is the benchmarked default; ultrafast
# is ~35% quicker and noticeably softer.
VIDEO_PRESET=veryfast
